<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plant Care Pro - Final Version</title>
    <link rel="icon" type="image/svg+xml" href="/assets/logo-mark.svg">
    <link rel="apple-touch-icon" href="/assets/logo.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#7CFFB2',
                        secondary: '#2F8F6B',
                        dark: '#F4F8EF',
                        darker: '#DDEDD7',
                        accent: '#FFB86B'
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --leaf-900: #10291f;
            --leaf-800: #173d2f;
            --leaf-700: #1f5b44;
            --leaf-500: #39b77a;
            --leaf-300: #9af5bd;
            --sand-50: #fbf7ed;
            --sand-100: #f4eddc;
            --moss-glass: rgba(255, 255, 255, 0.72);
            --moss-border: rgba(31, 91, 68, 0.16);
            --moss-shadow: 0 24px 70px rgba(16, 41, 31, 0.14);
        }

        body {
            color: var(--leaf-900) !important;
            background:
                radial-gradient(circle at top left, rgba(154, 245, 189, 0.7), transparent 28rem),
                radial-gradient(circle at 88% 8%, rgba(255, 184, 107, 0.5), transparent 24rem),
                linear-gradient(135deg, #eff8e9 0%, #fbf7ed 48%, #d6eee1 100%) !important;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            pointer-events: none;
            opacity: 0.5;
            background-image:
                linear-gradient(120deg, rgba(31, 91, 68, 0.05) 1px, transparent 1px),
                linear-gradient(30deg, rgba(31, 91, 68, 0.04) 1px, transparent 1px);
            background-size: 42px 42px, 58px 58px;
            z-index: 0;
        }

        body > .flex {
            position: relative;
            z-index: 1;
            padding: 1rem;
            gap: 1rem;
        }

        .bg-darker,
        .bg-dark,
        .bg-gray-800,
        .bg-gray-700,
        .bg-gray-900 {
            background: var(--moss-glass) !important;
            color: var(--leaf-900) !important;
            border-color: var(--moss-border) !important;
            box-shadow: var(--moss-shadow);
            backdrop-filter: blur(22px);
        }

        .text-white,
        .text-gray-100,
        .text-gray-200,
        .text-gray-300,
        .text-gray-400,
        .text-gray-500 {
            color: var(--leaf-900) !important;
        }

        .text-primary,
        .text-green-400,
        .text-cyan-400,
        .text-blue-400,
        .text-purple-400,
        .text-yellow-400 {
            color: var(--leaf-700) !important;
        }

        .border-gray-700,
        .border-gray-600,
        .border-gray-500 {
            border-color: var(--moss-border) !important;
        }

        header,
        #sidebar,
        main > .bg-dark,
        .tab-content,
        #plant-modal > div,
        #fertilizer-modal > div,
        #recipe-modal > div,
        #watering-modal > div,
        #settings-modal > div {
            background: var(--moss-glass) !important;
            border: 1px solid var(--moss-border) !important;
            box-shadow: var(--moss-shadow);
            backdrop-filter: blur(22px);
        }

        header {
            border-radius: 2rem;
            padding: 1rem 1.25rem !important;
        }

        #sidebar {
            border-radius: 2rem;
            margin-right: 1rem;
        }

        main {
            border-radius: 2rem;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.34);
            border: 1px solid var(--moss-border);
            box-shadow: var(--moss-shadow);
        }

        .tab-content {
            margin: 1rem;
            border-radius: 2rem;
        }

        .tab-btn {
            width: auto !important;
            min-width: 8.5rem;
            gap: 0.55rem;
            border-radius: 999px !important;
            padding: 0.75rem 1rem !important;
            background: rgba(255, 255, 255, 0.62) !important;
            color: var(--leaf-800) !important;
            border: 1px solid var(--moss-border);
        }

        .tab-btn::after {
            content: attr(title);
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.01em;
        }

        .tab-btn.bg-primary,
        .bg-primary,
        button[type='submit'] {
            background: linear-gradient(135deg, var(--leaf-500), var(--leaf-300)) !important;
            color: #063522 !important;
            box-shadow: 0 14px 28px rgba(57, 183, 122, 0.28);
        }

        button,
        a,
        select,
        input,
        textarea {
            border-radius: 1rem !important;
        }

        input,
        textarea,
        select {
            background: rgba(255, 255, 255, 0.74) !important;
            color: var(--leaf-900) !important;
            border: 1px solid var(--moss-border) !important;
        }

        .rounded-lg,
        .rounded-xl {
            border-radius: 1.25rem !important;
        }

        #plants-list > div,
        #fertilizers-grid > div,
        #recipes-list > div,
        #watering-history-list > div,
        #plant-calendars-container > div {
            border: 1px solid var(--moss-border) !important;
            background: rgba(255, 255, 255, 0.68) !important;
            box-shadow: 0 18px 50px rgba(16, 41, 31, 0.12) !important;
        }

        .brand-logo {
            width: 3.35rem;
            height: 3.35rem;
            border-radius: 1.35rem;
            box-shadow: 0 18px 36px rgba(30, 107, 59, 0.22);
            background: #e8f4ea;
        }

        #mobile-menu-btn {
            background: linear-gradient(135deg, var(--leaf-700), var(--leaf-500)) !important;
            color: #fff !important;
            border: 0 !important;
        }

        @media (max-width: 1023px) {
            body > .flex { padding: 0; }
            #sidebar { border-radius: 0 2rem 2rem 0; }
            header, main { border-radius: 0; }
        }
    </style>
</head>
