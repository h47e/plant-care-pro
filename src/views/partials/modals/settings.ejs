                                <div>
                                    <div class="text-gray-400">Последнее сохранение</div>
                                    <div class="font-medium" id="stats-last-save">-</div>
                                </div>
                            </div>
                            
                            <div class="border-t border-gray-600 mt-4 pt-4">
                                <div class="flex items-center justify-between">
                                    <div class="text-sm text-gray-400">Исходный код проекта</div>
