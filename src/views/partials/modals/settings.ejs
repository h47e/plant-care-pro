    <!-- Settings Modal -->
    <div id="settings-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-dark p-6 rounded-lg w-full max-w-2xl mx-4 max-h-[90vh] overflow-y-auto">
            <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span data-translate="Настройки">Настройки</span>
            </h2>
            <form id="settings-form">
                <div class="space-y-6">
                    <!-- General Settings -->
                    <div class="space-y-4">
                        <h3 class="text-lg font-semibold text-primary border-b border-gray-600 pb-2">🎨 Общие настройки</h3>
                        <div>
                            <label class="block text-sm font-medium mb-2">Название приложения</label>
                            <input id="settings-app-title" type="text" class="w-full bg-gray-700 text-white p-3 rounded-lg" placeholder="Plant Care Pro" required>
                            <div class="text-xs text-gray-400 mt-1">
                                Это название будет отображаться в заголовке приложения
                            </div>
                        </div>
                    </div>

                    <!-- Home Assistant Integration -->
                    <div class="space-y-4">
                        <h3 class="text-lg font-semibold text-primary border-b border-gray-600 pb-2">🏠 Интеграция с Home Assistant</h3>
                        
                        <div class="bg-gray-800 p-4 rounded-lg">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input id="settings-ha-enabled" type="checkbox" class="w-5 h-5 text-primary bg-gray-700 border-gray-600 rounded focus:ring-primary focus:ring-2">
                                <div>
                                    <div class="font-medium">Включить интеграцию с Home Assistant</div>
                                    <div class="text-sm text-gray-400">Синхронизация данных о растениях с системой умного дома</div>
                                </div>
                            </label>
                        </div>

                        <div id="ha-settings-content" class="space-y-4 hidden">
                            <div>
                                <label class="block text-sm font-medium mb-2">URL Home Assistant</label>
                                <input id="settings-ha-url" type="url" class="w-full bg-gray-700 text-white p-3 rounded-lg" placeholder="http://homeassistant.local:8123">
                                <div class="text-xs text-gray-400 mt-1">
                                    Адрес вашего Home Assistant (например: http://192.168.1.100:8123)
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium mb-2">Токен доступа</label>
                                <input id="settings-ha-token" type="password" class="w-full bg-gray-700 text-white p-3 rounded-lg" placeholder="Долгосрочный токен доступа">
                                <div class="text-xs text-gray-400 mt-1">
                                    Создайте токен в Профиле → Токены безопасности в Home Assistant
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium mb-2">Префикс сущностей</label>
                                <input id="settings-ha-prefix" type="text" class="w-full bg-gray-700 text-white p-3 rounded-lg" placeholder="plant_care" value="plant_care">
                                <div class="text-xs text-gray-400 mt-1">
                                    Префикс для создаваемых сущностей (например: sensor.plant_care_plant1_phase)
                                </div>
                            </div>

                            <div class="bg-blue-600/10 border border-blue-600/30 p-4 rounded-lg">
                                <h4 class="font-medium text-blue-400 mb-2">📊 Создаваемые сущности:</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• <code>sensor.{prefix}_{plant}_phase</code> - текущая фаза роста</li>
                                    <li>• <code>sensor.{prefix}_{plant}_day</code> - день с посадки</li>
                                    <li>• <code>sensor.{prefix}_{plant}_light_schedule</code> - расписание света</li>
                                    <li>• <code>binary_sensor.{prefix}_{plant}_needs_watering</code> - требуется полив</li>
                                    <li>• <code>sensor.{prefix}_total_plants</code> - общее количество растений</li>
                                </ul>
                            </div>

                            <div class="flex gap-3">
                                <button type="button" id="test-ha-connection" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors text-sm font-medium">
                                    🔗 Проверить соединение
                                </button>
                                <button type="button" id="sync-ha-entities" class="px-4 py-2 bg-green-600 hover:bg-green-700 rounded-lg transition-colors text-sm font-medium">
                                    🔄 Синхронизировать сущности
                                </button>
                            </div>

                            <div id="ha-connection-status" class="hidden p-3 rounded-lg text-sm">
                                <!-- Connection status will be shown here -->
                            </div>
                        </div>
                    </div>

                    <!-- Telegram Integration -->
                    <div class="space-y-4">
                        <h3 class="text-lg font-semibold text-primary border-b border-gray-600 pb-2">📱 Интеграция с Telegram</h3>
                        
                        <div class="bg-gray-800 p-4 rounded-lg">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input id="settings-telegram-enabled" type="checkbox" class="w-5 h-5 text-primary bg-gray-700 border-gray-600 rounded focus:ring-primary focus:ring-2">
                                <div>
                                    <div class="font-medium">Включить уведомления в Telegram</div>
                                    <div class="text-sm text-gray-400">Получение уведомлений о поливе и статусе растений</div>
                                </div>
                            </label>
                        </div>

                        <div id="telegram-settings-content" class="space-y-4 hidden">
                            <div>
                                <label class="block text-sm font-medium mb-2">Токен бота</label>
                                <input id="settings-telegram-token" type="password" class="w-full bg-gray-700 text-white p-3 rounded-lg" placeholder="1234567890:AABBCCDDEEFFGGHHIIJJKKLLMMNNOOPPQQRr">
                                <div class="text-xs text-gray-400 mt-1">
                                    Создайте бота через @BotFather и скопируйте токен
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium mb-2">Chat ID</label>
                                <div class="flex gap-2">
                                    <input id="settings-telegram-chat-id" type="text" class="flex-1 bg-gray-700 text-white p-3 rounded-lg" placeholder="123456789">
                                    <button type="button" id="get-telegram-chat-id" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors text-sm font-medium">
                                        Получить ID
                                    </button>
                                </div>
                                <div class="text-xs text-gray-400 mt-1">
                                    Отправьте команду /start боту, затем нажмите "Получить ID"
                                </div>
                            </div>

                            <div class="bg-gray-800 p-4 rounded-lg">
                                <h4 class="font-medium text-white mb-3">🔔 Настройки уведомлений</h4>
                                <div class="space-y-3">
                                    <label class="flex items-center gap-3 cursor-pointer">
                                        <input id="settings-telegram-watering-reminders" type="checkbox" class="w-4 h-4 text-primary bg-gray-700 border-gray-600 rounded focus:ring-primary focus:ring-2" checked>
                                        <div>
                                            <div class="text-sm font-medium">Напоминания о поливе</div>
                                            <div class="text-xs text-gray-400">Уведомления когда растения нуждаются в поливе</div>
                                        </div>
                                    </label>

                                    <label class="flex items-center gap-3 cursor-pointer">
                                        <input id="settings-telegram-phase-changes" type="checkbox" class="w-4 h-4 text-primary bg-gray-700 border-gray-600 rounded focus:ring-primary focus:ring-2" checked>
                                        <div>
                                            <div class="text-sm font-medium">Смена фаз роста</div>
                                            <div class="text-xs text-gray-400">Уведомления о переходе растений между фазами</div>
                                        </div>
                                    </label>

                                    <div class="border-t border-gray-600 pt-3">
                                        <label class="flex items-center gap-3 cursor-pointer mb-3">
                                            <input id="settings-telegram-daily-summary" type="checkbox" class="w-4 h-4 text-primary bg-gray-700 border-gray-600 rounded focus:ring-primary focus:ring-2">
                                            <div>
                                                <div class="text-sm font-medium">Ежедневная сводка</div>
                                                <div class="text-xs text-gray-400">Ежедневный отчет о состоянии растений</div>
                                            </div>
                                        </label>

                                        <div id="daily-summary-time" class="ml-7 hidden">
                                            <label class="block text-xs text-gray-400 mb-1">Время отправки сводки</label>
                                            <input id="settings-telegram-daily-time" type="time" value="09:00" class="bg-gray-700 text-white p-2 rounded text-sm">
                                        </div>
                                    </div>

                                    <div class="border-t border-gray-600 pt-3">
                                        <label class="flex items-center gap-3 cursor-pointer mb-3">
                                            <input id="settings-telegram-auto-backup" type="checkbox" class="w-4 h-4 text-primary bg-gray-700 border-gray-600 rounded focus:ring-primary focus:ring-2">
                                            <div>
                                                <div class="text-sm font-medium">Автоматический бэкап</div>
                                                <div class="text-xs text-gray-400">Регулярная отправка бэкапа данных в чат</div>
                                            </div>
                                        </label>

                                        <div id="telegram-backup-settings" class="ml-7 hidden space-y-3">
                                            <div class="grid grid-cols-2 gap-3">
                                                <div>
                                                    <label class="block text-xs text-gray-400 mb-1">Частота</label>
                                                    <select id="settings-telegram-backup-frequency" class="w-full bg-gray-700 text-white p-2 rounded text-sm">
                                                        <option value="daily">Ежедневно</option>
                                                        <option value="weekly" selected>Еженедельно</option>
                                                        <option value="monthly">Ежемесячно</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="block text-xs text-gray-400 mb-1">Время</label>
                                                    <input id="settings-telegram-backup-time" type="time" value="20:00" class="w-full bg-gray-700 text-white p-2 rounded text-sm">
                                                </div>
                                            </div>
                                            <div class="text-xs text-gray-500">
                                                Последний бэкап в Telegram: <span id="last-telegram-backup-time">никогда</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="flex flex-wrap gap-3">
                                <button type="button" id="test-telegram-connection" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors text-sm font-medium">
