        <!-- Header -->
        <header class="bg-dark border-b border-gray-700 px-6 py-3 flex items-center justify-between flex-shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-primary text-darker flex items-center justify-center shadow-lg text-xl">🌿</div>
                <div>
                    <div class="text-xs uppercase tracking-[0.35em] text-secondary font-bold">Greenhouse OS</div>
                    <h1 class="text-2xl font-black text-primary leading-tight">Plant Care Pro</h1>
                </div>
            </div>
            <div class="hidden md:flex flex-col items-end mr-4">
